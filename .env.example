# Copy to .env for local runs:  cp .env.example .env
# In GitHub, set these as repository Secrets (Settings > Secrets and variables > Actions).
# NEVER commit a real .env file.

# Required — Anthropic Claude API key (the LLM provider)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — only needed if the Apify data source is enabled in config/sources.yaml
APIFY_TOKEN=

# Optional — only needed if the GitHub trending source uses an authenticated call
GITHUB_TOKEN=
