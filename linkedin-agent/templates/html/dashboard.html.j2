<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Purands AI — Daily Review · {{ run_date }}</title>
<style>
  :root{
    --bg:#0f1115; --card:#181b22; --ink:#e8eaed; --muted:#9aa0aa; --line:#262a33;
    --accent:#4f8cff; --high:#2ec16b; --medium:#e0a93b; --low:#e0533b;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    background:var(--bg);color:var(--ink);line-height:1.55}
  header{position:sticky;top:0;z-index:10;background:rgba(15,17,21,.92);backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);padding:14px 20px}
  header h1{font-size:18px;margin:0}
  header .sub{color:var(--muted);font-size:13px}
  nav{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
  nav a{font-size:13px;color:var(--accent);text-decoration:none;border:1px solid var(--line);
    padding:4px 10px;border-radius:999px}
  nav a:hover{background:var(--card)}
  main{max-width:920px;margin:0 auto;padding:20px}
  section{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px;margin:16px 0}
  section h2{margin:0 0 12px;font-size:16px}
  .rec{display:inline-block;padding:3px 10px;border-radius:6px;font-size:12px;font-weight:600;text-transform:uppercase}
  .rec.publish{background:rgba(46,193,107,.15);color:var(--high)}
  .rec.revise{background:rgba(224,169,59,.15);color:var(--medium)}
  .rec.hold{background:rgba(224,83,59,.15);color:var(--low)}
  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
  th{color:var(--muted);font-weight:600}
  .badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:12px;font-weight:600}
  .badge.high{background:rgba(46,193,107,.15);color:var(--high)}
  .badge.medium{background:rgba(224,169,59,.15);color:var(--medium)}
  .badge.low{background:rgba(224,83,59,.15);color:var(--low)}
  details{border:1px solid var(--line);border-radius:8px;padding:10px 12px;margin:8px 0;background:#13161c}
  details summary{cursor:pointer;font-weight:600}
  .copywrap{position:relative}
  .post{white-space:pre-wrap;background:#0d0f13;border:1px solid var(--line);border-radius:8px;
    padding:14px;font-size:14.5px}
  .copybtn{background:var(--accent);color:#fff;border:0;border-radius:6px;padding:6px 12px;
    font-size:13px;cursor:pointer;margin-top:8px}
  .copybtn:active{transform:translateY(1px)}
  .hooks li,.tags span{margin:4px 0}
  .tags span{display:inline-block;background:#0d0f13;border:1px solid var(--line);
    border-radius:999px;padding:2px 10px;margin-right:6px;font-size:13px;color:var(--accent)}
  a.src{color:var(--accent);font-size:13px}
  .muted{color:var(--muted)}
  .postcard{border:1px solid var(--line);border-radius:10px;padding:14px;margin:14px 0;background:#13161c}
  .postcard.tied{border-color:var(--high);box-shadow:inset 3px 0 0 var(--high)}
  .postcard h3.ptitle{margin:0 0 10px;font-size:15px;color:var(--ink)}
  .pbadge{display:inline-block;margin-left:6px;padding:2px 8px;border-radius:999px;font-size:11px;
    font-weight:700;background:rgba(46,193,107,.15);color:var(--high);vertical-align:middle}
  .rtitle{font-weight:600;margin:10px 0 2px}
  .visual{margin:12px 0;border:1px solid var(--line);border-radius:8px;padding:12px;background:#0d0f13}
  .visual .vhead{display:flex;align-items:center;gap:8px;margin-bottom:8px}
  .vkind{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;
    padding:2px 8px;border-radius:999px;background:rgba(79,140,255,.15);color:var(--accent)}
  .postimg{max-width:100%;border-radius:8px;border:1px solid var(--line);display:block}
  .vcaption{margin:8px 0 0;font-size:13px}
  .dlbtn{background:transparent;color:var(--accent);border:1px solid var(--line);border-radius:6px;
    padding:5px 10px;font-size:12px;cursor:pointer;margin-top:8px;margin-right:6px;text-decoration:none;
    display:inline-block}
  .dlbtn:hover{background:var(--card)}
  ul{margin:6px 0 0 18px;padding:0}
  footer{max-width:920px;margin:0 auto;padding:10px 20px 40px;color:var(--muted);font-size:12px}
</style>
</head>
<body>
<header>
  <h1>Purands AI — Daily Content Review</h1>
  <div class="sub">{{ run_date }} · generated {{ generated_at }} · <strong>review only — nothing is auto-published</strong></div>
  <nav>
    <a href="#rec">Recommendation</a>
    <a href="#posts">Posts ({{ drafts|length }})</a>
    <a href="#trends">Trends</a>
    <a href="#comments">Comments ({{ comments|length }})</a>
    <a href="#risk">Risk</a>
  </nav>
</header>
<main>

  <section id="rec">
    <h2>Publishing Recommendation</h2>
    {% set rec = editorial.publishing_recommendation|default('hold') %}
    <span class="rec {{ rec }}">{{ rec }}</span>
    <p class="muted">{{ editorial.reasoning }}</p>
    <p>{{ editorial.summary }}</p>
  </section>

  <section id="posts">
    <h2>LinkedIn Posts ({{ drafts|length }})</h2>
    {% if drafts %}
      {% for draft in drafts %}
      {% set pidx = loop.index %}
      <div class="postcard{% if draft.purands_tie %} tied{% endif %}">
        <h3 class="ptitle">{{ pidx }}. {{ draft.topic }}
          {% if draft.purands_tie %}<span class="pbadge">★ Purands solution · high priority</span>{% endif %}
        </h3>
        <div class="copywrap">
          <div class="post" id="postbody{{ pidx }}">{{ draft.body }}</div>
          <button class="copybtn" onclick="copyEl('postbody{{ pidx }}',this)">Copy post</button>
        </div>
        {% if draft.hashtags %}<div class="tags">{% for h in draft.hashtags %}<span>#{{ h }}</span>{% endfor %}</div>{% endif %}
        {% if draft.cta %}<p class="muted"><strong>CTA:</strong> {{ draft.cta }}</p>{% endif %}

        {% set v = draft.visual %}
        {% if v and v.kind and v.kind != 'none' %}
        <div class="visual">
          <div class="vhead"><span class="vkind">Suggested {{ v.kind }}</span>
            {% if v.alt_text %}<span class="muted" style="font-size:12px">{{ v.alt_text }}</span>{% endif %}
          </div>
          {% if v.kind == 'chart' and v.chart %}
            <div id="chart{{ pidx }}">{{ render_chart(v.chart)|safe }}</div>
            <button class="dlbtn" onclick="downloadChart('chart{{ pidx }}','post{{ pidx }}-chart')">⬇ Download PNG</button>
            <button class="dlbtn" onclick="downloadSvg('chart{{ pidx }}','post{{ pidx }}-chart')">⬇ SVG</button>
          {% elif v.kind == 'image' %}
            {% if v.image_path %}
              <img class="postimg" src="{{ v.image_path }}" alt="{{ v.alt_text }}">
              <a class="dlbtn" href="{{ v.image_path }}" download="post{{ pidx }}-image.png">⬇ Download image</a>
            {% else %}
              <p class="muted">No image generated. Use the prompt below to create one (enable <code>images</code> in config to auto-generate).</p>
            {% endif %}
            {% if v.image_prompt %}
            <details>
              <summary>Image prompt{% if v.style %} · {{ v.style }}{% endif %}</summary>
              <div class="copywrap"><div class="post" id="imgp{{ pidx }}">{{ v.image_prompt }}</div>
                <button class="copybtn" onclick="copyEl('imgp{{ pidx }}',this)">Copy prompt</button></div>
            </details>
            {% endif %}
          {% endif %}
          {% if v.caption %}<p class="vcaption"><strong>Caption:</strong> {{ v.caption }}</p>{% endif %}
        </div>
        {% endif %}

        {% if draft.hooks %}
        <details>
          <summary>Alternative hooks</summary>
          <ol class="hooks">
            {% for hook in draft.hooks %}
            <li class="copywrap"><span id="p{{ pidx }}h{{ loop.index }}">{{ hook }}</span>
              <button class="copybtn" onclick="copyEl('p{{ pidx }}h{{ loop.index }}',this)">Copy</button></li>
            {% endfor %}
          </ol>
        </details>
        {% endif %}

        <details>
          <summary>Research behind this post (sources, summaries &amp; confidence)</summary>
          {% for title in draft.based_on %}
            {% set r = research_by_title.get(title) %}
            {% if r %}
              <p class="rtitle">{{ r.trend.title }}
                <span class="badge {{ r.confidence|confidence_class }}">conf {{ '%.2f'|format(r.confidence) }}</span>
                {% if r.trend.category %}<span class="muted">· {{ r.trend.category }}</span>{% endif %}
              </p>
              {% if r.trend.rationale %}<p class="muted">{{ r.trend.rationale }}</p>{% endif %}
              {% if r.evidence %}<p><strong>Sources &amp; what I took from each</strong></p>
                <ul>{% for e in r.evidence %}<li>{{ e.claim }}: {{ e.support }}
                  {% if e.url %}<a class="src" href="{{ e.url }}" target="_blank" rel="noopener">↗ read source</a>{% endif %}</li>{% endfor %}</ul>{% endif %}
              {% if r.statistics %}<p><strong>Statistics</strong></p><ul>{% for s in r.statistics %}<li>{{ s }}</li>{% endfor %}</ul>{% endif %}
              {% if r.examples %}<p><strong>Examples</strong></p><ul>{% for s in r.examples %}<li>{{ s }}</li>{% endfor %}</ul>{% endif %}
              {% if r.recent_news %}<p><strong>Recent news</strong></p><ul>{% for s in r.recent_news %}<li>{{ s }}</li>{% endfor %}</ul>{% endif %}
              {% if r.trend.sources %}<p><strong>Original trend links</strong></p><ul>{% for s in r.trend.sources %}<li><a class="src" href="{{ s }}" target="_blank" rel="noopener">{{ s }}</a></li>{% endfor %}</ul>{% endif %}
              {% if r.risks %}<p><strong>Risks / caveats</strong></p><ul>{% for s in r.risks %}<li>{{ s }}</li>{% endfor %}</ul>{% endif %}
            {% else %}
              <p class="muted">Research detail not found for: {{ title }}</p>
            {% endif %}
          {% endfor %}
        </details>
      </div>
      {% endfor %}
    {% else %}
      <p class="muted">No posts were generated (no high-confidence trends today).</p>
    {% endif %}
  </section>

  <section id="trends">
    <h2>Today's Trends</h2>
    {% if trends %}
    <table>
      <tr><th>#</th><th>Trend</th><th>Category</th><th>Why it matters</th></tr>
      {% for t in trends %}
      <tr>
        <td>{{ t.rank }}</td>
        <td>{{ t.title }}
          {% if t.sources %}<br>{% for s in t.sources %}<a class="src" href="{{ s }}" target="_blank" rel="noopener">source</a> {% endfor %}{% endif %}
        </td>
        <td>{{ t.category }}</td>
        <td>{{ t.rationale }}</td>
      </tr>
      {% endfor %}
    </table>
    {% else %}<p class="muted">No trends identified.</p>{% endif %}
  </section>

  <section id="comments">
    <h2>Suggested LinkedIn Comments ({{ comments|length }})</h2>
    <p class="muted">Open each post, then paste the copied comment. Nothing is posted automatically.</p>
    {% if comments %}
      {% for c in comments %}
      <details>
        <summary>{{ loop.index }}. {{ c.angle }}{% if c.target_author %} · {{ c.target_author }}{% endif %} — {{ c.target_excerpt[:80] }}</summary>
        {% if c.target_author %}<p class="muted"><strong>Post by:</strong> {{ c.target_author }}</p>{% endif %}
        <div class="copywrap">
          <div class="post" id="cmt{{ loop.index }}">{{ c.comment }}</div>
          <button class="copybtn" onclick="copyEl('cmt{{ loop.index }}',this)">Copy comment</button>
        </div>
        <p class="muted">Why it works: {{ c.why_it_works }}</p>
        {% if c.target_post_url %}<a class="src" href="{{ c.target_post_url }}" target="_blank" rel="noopener">↗ Open LinkedIn post to paste comment</a>{% endif %}
      </details>
      {% endfor %}
    {% else %}<p class="muted">No comment suggestions.</p>{% endif %}
  </section>

  <section id="risk">
    <h2>Risk Assessment</h2>
    {% if editorial.risk_assessment %}
      <ul>{% for risk in editorial.risk_assessment %}<li>{{ risk }}</li>{% endfor %}</ul>
    {% else %}<p class="muted">No risks flagged.</p>{% endif %}
  </section>

</main>
<footer>Generated by the Purands AI platform · human review required before any publishing.</footer>
<script>
function copyEl(id,btn){
  const el=document.getElementById(id);
  const text=el.innerText;
  navigator.clipboard.writeText(text).then(()=>{
    const old=btn.innerText;btn.innerText='Copied ✓';
    setTimeout(()=>btn.innerText=old,1500);
  });
}
function _svgOf(containerId){
  const svg=document.getElementById(containerId).querySelector('svg');
  const clone=svg.cloneNode(true);
  clone.setAttribute('xmlns','http://www.w3.org/2000/svg');
  return new XMLSerializer().serializeToString(clone);
}
function _download(url,name){
  const a=document.createElement('a');a.href=url;a.download=name;
  document.body.appendChild(a);a.click();a.remove();
}
function downloadSvg(containerId,name){
  const blob=new Blob([_svgOf(containerId)],{type:'image/svg+xml'});
  const url=URL.createObjectURL(blob);_download(url,name+'.svg');
  setTimeout(()=>URL.revokeObjectURL(url),2000);
}
// Rasterise the inline SVG to a high-res PNG for attaching to LinkedIn.
function downloadChart(containerId,name){
  const svg=document.getElementById(containerId).querySelector('svg');
  const vb=svg.viewBox.baseVal;const scale=2;
  const w=(vb&&vb.width)||720, h=(vb&&vb.height)||340;
  const img=new Image();
  const blob=new Blob([_svgOf(containerId)],{type:'image/svg+xml;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  img.onload=function(){
    const c=document.createElement('canvas');c.width=w*scale;c.height=h*scale;
    const ctx=c.getContext('2d');ctx.scale(scale,scale);ctx.drawImage(img,0,0);
    URL.revokeObjectURL(url);
    c.toBlob(function(b){const u=URL.createObjectURL(b);_download(u,name+'.png');
      setTimeout(()=>URL.revokeObjectURL(u),2000);});
  };
  img.onerror=function(){URL.revokeObjectURL(url);downloadSvg(containerId,name);};
  img.src=url;
}
</script>
</body>
</html>
